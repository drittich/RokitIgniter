<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<VersionPrefix>0.2.0</VersionPrefix>
		<VersionSuffix>$([System.DateTime]::UtcNow.ToString(`yyyyMMdd-HHmm`))</VersionSuffix>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>RokitIgniter.ico</ApplicationIcon>
		<DebugType>none</DebugType>
		<PackageIcon>RokitIgniter.ico</PackageIcon>
		<AssemblyVersion>0.2.0</AssemblyVersion>
		<!-- single-file publish: embed Avalonia's native libraries (SkiaSharp, HarfBuzzSharp, ANGLE) in the executable -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<!-- the test project lives in a subfolder; keep its sources out of the app's default globs -->
		<DefaultItemExcludes>$(DefaultItemExcludes);RokitIgniter.Tests/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.22" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
		<!-- provides SoundPlayer on plain net10.0 -->
		<PackageReference Include="System.Windows.Extensions" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="RokitIgniter.ico">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="RokitIgniter.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="10Hz.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="RokitIgniter.ico">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
