<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
		Platform-neutral tests only. Do not reference RokitIgniter.csproj, Avalonia, or any
		OS-specific API: link the shared source files under test instead, e.g.
		<Compile Include="..\Igniter.cs" Link="Linked\Igniter.cs" />
	-->

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Igniter.cs" Link="Linked\Igniter.cs" />
		<Compile Include="..\ITonePlayer.cs" Link="Linked\ITonePlayer.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>
</Project>
