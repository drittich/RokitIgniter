<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RokitIgniter.MessageDialog"
        Title="RokitIgniter"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
	<StackPanel Margin="20" Spacing="16" MinWidth="240">
		<TextBlock x:Name="MessageText" TextWrapping="Wrap" />
		<Button x:Name="OkButton" Content="OK" IsDefault="True" HorizontalAlignment="Right" MinWidth="72" HorizontalContentAlignment="Center" />
	</StackPanel>
</Window>
